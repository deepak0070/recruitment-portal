# Server Configuration
PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# JWT Configuration
JWT_SECRET=recruitment_portal_super_secret_jwt_key_2026
JWT_EXPIRES_IN=7d

# MySQL Configuration (Relational: users, jobs, applications)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=recruitment_portal

# MongoDB Configuration (Flexible: activity_logs, applicant_notes)
MONGODB_URI=mongodb://127.0.0.1:27017/recruitment_portal

# External Job APIs (Adzuna India, Jooble, Careerjet)
# Get free Adzuna App ID & Key instantly from: https://developer.adzuna.com
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRY=in

# Get free Jooble key from: https://jooble.org/api/about
JOOBLE_API_KEY=

# Careerjet Partner ID
CAREERJET_AFFID=
