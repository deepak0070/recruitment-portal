{
  "name": "recruitment-portal-monorepo",
  "version": "1.0.0",
  "description": "Production-grade Recruitment Portal with Express, React (Vite), MySQL and MongoDB",
  "scripts": {
    "install:all": "npm install --prefix backend && npm install --prefix frontend",
    "backend:dev": "npm run dev --prefix backend",
    "backend:start": "npm start --prefix backend",
    "backend:test": "npm test --prefix backend",
    "frontend:dev": "npm run dev --prefix frontend",
    "frontend:build": "npm run build --prefix frontend",
    "db:init": "npm run db:init --prefix backend",
    "db:seed": "npm run db:seed --prefix backend"
  },
  "keywords": [
    "recruitment",
    "portal",
    "express",
    "react",
    "mysql",
    "mongodb"
  ],
